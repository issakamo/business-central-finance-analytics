table _Measures
	lineageTag: 11d55bab-bd67-4e2a-9d38-6d9dbb035111

	measure 'Sales Amount' = SUM ( 'Fact Sales'[salesAmountActual] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 24c889d1-907e-4a97-94cd-75c984e1c8bc

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure COGS = - SUM ( 'Fact Sales'[costAmountActual] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 30521ff2-06a8-4a24-b1b3-4772fff1437b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Gross Margin' = [Sales Amount] - [COGS]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 9abf936c-1e9c-43d4-b307-515408d28b23

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Gross Margin %' = DIVIDE ( [Gross Margin], [Sales Amount] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: cfdc379f-fbaf-406c-a0cb-a92718500baa

	measure 'Quantity Sold' = - SUM ( 'Fact Sales'[invoicedQuantity] )
		formatString: 0
		lineageTag: ee7fa802-6ce6-4f57-ad54-8884823400db

	measure 'Sales Amount PY' = CALCULATE ( [Sales Amount], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: c8ff4b64-196e-481c-b264-1c1abd1e20c1

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Sales YoY %' = DIVIDE ( [Sales Amount] - [Sales Amount PY], [Sales Amount PY] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c4ce510e-c87a-4dba-ae60-b11d8bdbaadd

	measure 'Reporting Through' =
			
			VAR LastSale = CALCULATE ( MAX ( 'Fact Sales'[postingDate] ), REMOVEFILTERS () )
			RETURN EOMONTH ( LastSale, -1 )
		formatString: m/d/yyyy
		lineageTag: d1d9e320-f080-4640-bc43-3d081b53fdfe

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	measure 'GL Actual' =
			
			VAR Cutoff = [Reporting Through]
			RETURN CALCULATE ( - SUM ( 'Fact GL Actual'[amount] ), KEEPFILTERS ( 'Date'[Date] <= Cutoff ) )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 5be51f08-e8ed-48ad-98f2-176fb73a0e5f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'GL Budget' =
			
			VAR Cutoff = [Reporting Through]
			RETURN CALCULATE ( - SUM ( 'Fact GL Budget'[amount] ), KEEPFILTERS ( 'Date'[Date] <= Cutoff ) )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 79732579-fd2f-4809-8a68-bff4670edfc2

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'GL Budget Full Year' = - SUM ( 'Fact GL Budget'[amount] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 9429fc35-291e-4e38-b769-ab2b5d331468

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'GL Variance' = [GL Actual] - [GL Budget]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 2341d27f-6031-45c4-b981-8daa97564e1f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'GL Variance %' = DIVIDE ( [GL Variance], ABS ( [GL Budget] ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 56603a9d-ef80-4784-a0e2-bc4e0eacee1a

	measure 'AR Balance' =
			
			VAR Cutoff = [Reporting Through]
			VAR AsOf = MIN ( MAX ( 'Date'[Date] ), Cutoff )
			RETURN
			    IF (
			        MIN ( 'Date'[Date] ) > Cutoff,
			        BLANK (),
			        CALCULATE (
			            SUM ( 'Fact AR Detail'[amountLCY] ),
			            REMOVEFILTERS ( 'Date' ),
			            'Date'[Date] <= AsOf
			        )
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 923ca263-24bc-4e54-a59a-49dbe72cb94f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'AR Aged Balance' =
			
			VAR Cutoff = [Reporting Through]
			VAR AsOf = MIN ( MAX ( 'Date'[Date] ), Cutoff )
			VAR MinDays = MIN ( 'Aging Bucket'[Min Days] )
			VAR MaxDays = MAX ( 'Aging Bucket'[Max Days] )
			VAR LedgerEntries =
			    CALCULATETABLE (
			        SUMMARIZE (
			            'Fact AR Detail',
			            'Fact AR Detail'[custLedgerEntryNo],
			            'Fact AR Detail'[dueDate]
			        ),
			        REMOVEFILTERS ( 'Date' ),
			        'Date'[Date] <= AsOf
			    )
			VAR Result =
			    SUMX (
			        LedgerEntries,
			        VAR DaysOverdue = INT ( AsOf - 'Fact AR Detail'[dueDate] )
			        VAR Remaining =
			            CALCULATE (
			                SUM ( 'Fact AR Detail'[amountLCY] ),
			                REMOVEFILTERS ( 'Date' ),
			                'Date'[Date] <= AsOf
			            )
			        RETURN
			            IF ( DaysOverdue >= MinDays && DaysOverdue <= MaxDays, Remaining )
			    )
			RETURN
			    IF ( MIN ( 'Date'[Date] ) > Cutoff || Result = 0, BLANK (), Result )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 7670b23b-7b27-40c2-823d-dd5265f92f0d

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Credit Sales' =
			
			CALCULATE (
			    SUM ( 'Fact AR Detail'[amountLCY] ),
			    'Fact AR Detail'[entryType] = "Initial Entry",
			    'Fact AR Detail'[documentType] IN { "Invoice", "Credit Memo" }
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 0f6897d7-23e9-4ac8-9f24-0ac0e5fb672c

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure DSO =
			
			VAR Cutoff = [Reporting Through]
			VAR AsOf = MIN ( MAX ( 'Date'[Date] ), Cutoff )
			VAR WindowDays = 90
			VAR SalesInWindow =
			    CALCULATE (
			        [Credit Sales],
			        REMOVEFILTERS ( 'Date' ),
			        'Date'[Date] > AsOf - WindowDays,
			        'Date'[Date] <= AsOf
			    )
			RETURN
			    IF (
			        MIN ( 'Date'[Date] ) > Cutoff,
			        BLANK (),
			        DIVIDE ( [AR Balance], SalesInWindow ) * WindowDays
			    )
		formatString: 0.0
		lineageTag: d7181c28-9a21-492f-877d-194db1ed47d6

	measure 'AP Balance' =
			
			VAR Cutoff = [Reporting Through]
			VAR AsOf = MIN ( MAX ( 'Date'[Date] ), Cutoff )
			RETURN
			    IF (
			        MIN ( 'Date'[Date] ) > Cutoff,
			        BLANK (),
			        - CALCULATE (
			            SUM ( 'Fact AP Detail'[amountLCY] ),
			            REMOVEFILTERS ( 'Date' ),
			            'Date'[Date] <= AsOf
			        )
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 065d3b6d-7b84-401c-80bd-bf409afb99d9

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'AP Aged Balance' =
			
			VAR Cutoff = [Reporting Through]
			VAR AsOf = MIN ( MAX ( 'Date'[Date] ), Cutoff )
			VAR MinDays = MIN ( 'Aging Bucket'[Min Days] )
			VAR MaxDays = MAX ( 'Aging Bucket'[Max Days] )
			VAR LedgerEntries =
			    CALCULATETABLE (
			        SUMMARIZE (
			            'Fact AP Detail',
			            'Fact AP Detail'[vendorLedgerEntryNo],
			            'Fact AP Detail'[dueDate]
			        ),
			        REMOVEFILTERS ( 'Date' ),
			        'Date'[Date] <= AsOf
			    )
			VAR Result =
			    SUMX (
			        LedgerEntries,
			        VAR DaysOverdue = INT ( AsOf - 'Fact AP Detail'[dueDate] )
			        VAR Remaining =
			            - CALCULATE (
			                SUM ( 'Fact AP Detail'[amountLCY] ),
			                REMOVEFILTERS ( 'Date' ),
			                'Date'[Date] <= AsOf
			            )
			        RETURN
			            IF ( DaysOverdue >= MinDays && DaysOverdue <= MaxDays, Remaining )
			    )
			RETURN
			    IF ( MIN ( 'Date'[Date] ) > Cutoff || Result = 0, BLANK (), Result )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: fc931c1a-83d6-4bb2-b49c-aaca0617d336

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Credit Purchases' =
			
			- CALCULATE (
			    SUM ( 'Fact AP Detail'[amountLCY] ),
			    'Fact AP Detail'[entryType] = "Initial Entry",
			    'Fact AP Detail'[documentType] IN { "Invoice", "Credit Memo" }
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: ad23df08-79b3-42d7-a318-b983bc3c937e

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure DPO =
			
			VAR Cutoff = [Reporting Through]
			VAR AsOf = MIN ( MAX ( 'Date'[Date] ), Cutoff )
			VAR WindowDays = 90
			VAR COGSInWindow =
			    CALCULATE (
			        [COGS],
			        REMOVEFILTERS ( 'Date' ),
			        'Date'[Date] > AsOf - WindowDays,
			        'Date'[Date] <= AsOf
			    )
			RETURN
			    IF (
			        MIN ( 'Date'[Date] ) > Cutoff,
			        BLANK (),
			        DIVIDE ( [AP Balance], COGSInWindow ) * WindowDays
			    )
		formatString: 0.0
		lineageTag: d1098a97-525d-4f14-a5d7-7fb9bb0e340e

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

