	partition Date = calculated
		mode: import
		source =
				
				VAR FirstYear = YEAR ( MIN ( 'Fact Sales'[postingDate] ) )
				VAR LastYear  = YEAR ( MAX ( 'Fact Sales'[postingDate] ) )
				RETURN
				    ADDCOLUMNS (
				        CALENDAR ( DATE ( FirstYear, 1, 1 ), DATE ( LastYear, 12, 31 ) ),
				        "Year", YEAR ( [Date] ),
				        "Quarter", "Q" & QUARTER ( [Date] ),
				        "Year Quarter", YEAR ( [Date] ) & " Q" & QUARTER ( [Date] ),
				        "Month Number", MONTH ( [Date] ),
				        "Month", FORMAT ( [Date], "mmm" ),
				        "Year Month", FORMAT ( [Date], "mmm yyyy" ),
				        "Year Month Sort", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				        "Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
				        "Day of Week Number", WEEKDAY ( [Date], 2 ),
				        "Day of Week", FORMAT ( [Date], "ddd" )
				    )

	annotation PBI_Id = 5a7767577e5f4cab8e84950bfd1b7530

