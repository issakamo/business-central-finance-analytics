model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Fact Sales","_Measures","Dim Customer","Dim Item","Dim Salesperson","Dim GL Account","Fact GL Actual","Fact GL Budget"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Fact Sales'
ref table Date
ref table _Measures
ref table 'Dim Customer'
ref table 'Dim Item'
ref table 'Dim Salesperson'
ref table 'Dim GL Account'
ref table 'Fact GL Actual'
ref table 'Fact GL Budget'

ref cultureInfo en-US

